---
// Das Spiel Kistenschieber: eine Seite, die Bildschirme wechseln per Hash (#level, #einstellungen, #lektion-N).
// Nicht im Suchindex (die Seite zum Spiel steht auf www.mitwachsen-spiele.de); die h1 steht sichtbar im Startbildschirm.
import BaseLayout from '../layouts/BaseLayout.astro';
import KistenschieberGame from '../components/KistenschieberGame.astro';
---

<BaseLayout noindex bodyClass="ks-body" skipLink={false}>
  <main id="inhalt" tabindex="-1">
    <KistenschieberGame />
  </main>
</BaseLayout>
